          "required": true,
          "description": "User message text"
        }
      ],
      "readOnly": true,
      "requestExample": "curl -X POST http://localhost:8080/seaf-core/api/new/chat/message -H \"Content-Type: application/json\" -d '{\"sessionId\": \"uuid\", \"message\": \"Which components use Kafka?\"}'",
      "responseDescription": "Server-Sent Events stream (Content-Type: text/event-stream). Chunks: data: {...}. End: data: [DONE]",
      "hidden": true
    },
    {
      "id": "post_seaf_core_api_new_chat_end",
      "description": "End a chat session and release resources",
      "method": "POST",
      "path": "/seaf-core/api/new/chat/end",
      "pathParams": [],
      "queryParams": [],
      "bodyParams": [
        {
          "name": "sessionId",
          "type": "string",
          "required": true,
          "description": "Session UUID to terminate"
        }
      ],
      "readOnly": false,
      "requestExample": "curl -X POST http://localhost:8080/seaf-core/api/new/chat/end -H \"Content-Type: application/json\" -d '{\"sessionId\": \"uuid\"}'",
      "responseDescription": "Returns success response",
      "hidden": true
    }
  ]
}
