      "method": "PUT",
      "path": "/seaf-core/api/logger/update-level",
      "pathParams": [],
      "queryParams": [
        {
          "name": "secret",
          "type": "string",
          "required": false,
          "description": "Secret from VUE_APP_DOCHUB_RELOAD_SECRET env variable"
        },
        {
          "name": "level",
          "type": "string",
          "required": true,
          "description": "Log level: trace, debug, info, warn, error"
        }
      ],
      "bodyParams": [],
      "readOnly": false,
      "requestExample": "curl -X PUT \"http://localhost:8080/seaf-core/api/logger/update-level?level=debug\"",
      "responseDescription": "Returns success/error response",
      "hidden": true
    },
    {
      "id": "get_seaf_core_api_logger_level",
      "description": "Get the current logging level",
      "method": "GET",
      "path": "/seaf-core/api/logger/level",
      "pathParams": [],
      "queryParams": [],
      "bodyParams": [],
      "readOnly": true,
      "requestExample": "curl \"http://localhost:8080/seaf-core/api/logger/level\"",
      "responseDescription": "Returns {\"level\": \"info\"}",
      "hidden": true
    },
    {
      "id": "get_seaf_core_api_new_chat_agents",
      "description": "List of available AI agents",
      "method": "GET",
      "path": "/seaf-core/api/new/chat/agents",
      "pathParams": [],
      "queryParams": [],
      "bodyParams": [],
      "readOnly": true,
      "requestExample": "curl http://localhost:8080/seaf-core/api/new/chat/agents",
      "responseDescription": "Array of available AI agent configurations",
      "hidden": true
    },
    {
      "id": "post_seaf_core_api_new_chat_start",
      "description": "Start a new chat session",
      "method": "POST",
      "path": "/seaf-core/api/new/chat/start",
      "pathParams": [],
      "queryParams": [],
      "bodyParams": [
        {
          "name": "sessionId",
          "type": "string",
          "required": false,
          "description": "Optional custom session ID"
        },
        {
          "name": "type",
          "type": "string",
          "required": true,
          "description": "Agent type"
        },
        {
          "name": "systemPrompt",
          "type": "string",
          "required": false,
          "description": "System prompt for the agent"
        },
        {
          "name": "config",
          "type": "object",
          "required": false,
          "description": "Additional configuration object"
        }
      ],
      "readOnly": false,
      "requestExample": "curl -X POST http://localhost:8080/seaf-core/api/new/chat/start -H \"Content-Type: application/json\" -d '{\"type\": \"AgentType\", \"systemPrompt\": \"You are an architecture assistant...\"}'",
      "responseDescription": "Returns {\"sessionId\": \"uuid\"}",
      "hidden": true
    },
    {
      "id": "post_seaf_core_api_new_chat_message",
      "description": "Send a message to a session. Response is a Server-Sent Events stream",
      "method": "POST",
      "path": "/seaf-core/api/new/chat/message",
      "pathParams": [],
      "queryParams": [],
      "bodyParams": [
        {
          "name": "sessionId",
          "type": "string",
          "required": true,
          "description": "Session UUID from /chat/start"
        },
